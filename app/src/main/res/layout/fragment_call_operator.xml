<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp"
    tools:context=".ui.CallOperatorFragment">

    <TextView
        android:id="@+id/text_call_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="-0.03"
        android:text="@string/appointments_calling"
        android:textColor="@color/bob_black"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_back"
        style="@style/BuddyButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/back" />
</LinearLayout>

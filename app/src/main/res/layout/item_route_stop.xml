<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_panel_round"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/text_route_order"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:textColor="@color/bob_white"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="1" />

    <TextView
        android:id="@+id/text_route_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:textColor="@color/bob_black"
        android:textSize="@dimen/text_small"
        android:textStyle="bold"
        tools:text="Tavolo 3" />

    <Button
        android:id="@+id/btn_route_remove"
        style="@style/BuddyButton.Danger"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="0dp"
        android:padding="0dp"
        android:text="✕"
        android:textSize="14sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:orientation="horizontal"
    android:padding="@dimen/screen_padding"
    tools:context=".ui.PlacesFragment">

    <!-- Left: place list -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.03"
            android:text="@string/places_title"
            android:textColor="@color/bob_black"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/places_hint"
            android:textColor="@color/bob_muted"
            android:textSize="@dimen/text_small" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_places"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_place" />

        <TextView
            android:id="@+id/text_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/places_loading"
            android:textColor="@color/bob_muted"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Right: route summary + controls -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Percorso"
            android:textColor="@color/bob_black"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_route"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/text_route_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Nessun punto selezionato"
            android:textColor="@color/bob_muted"
            android:textSize="@dimen/text_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/places_wait_label"
                android:textColor="@color/bob_black"
                android:textSize="@dimen/text_small" />

            <EditText
                android:id="@+id/edit_wait_seconds"
                android:layout_width="80dp"
                android:layout_height="@dimen/input_height"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_panel_round"
                android:gravity="center"
                android:inputType="number"
                android:paddingHorizontal="8dp"
                android:text="10"
                android:textColor="@color/bob_black"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/check_return"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"
            android:text="@string/places_return"
            android:textColor="@color/bob_black"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/text_nav_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel_round"
            android:minHeight="40dp"
            android:padding="10dp"
            android:textColor="@color/bob_navy"
            android:textSize="@dimen/text_small"
            tools:text="Pronto" />

        <Button
            android:id="@+id/btn_start"
            style="@style/BuddyButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_marginTop="8dp"
            android:text="@string/places_start" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_stop_nav"
                style="@style/BuddyButton.Danger"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_secondary"
                android:layout_weight="1"
                android:text="@string/places_stop" />

            <Button
                android:id="@+id/btn_back"
                style="@style/BuddyButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_secondary"
                android:layout_weight="1"
                android:text="@string/back" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

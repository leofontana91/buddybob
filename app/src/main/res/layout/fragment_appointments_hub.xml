<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:orientation="vertical"
    android:padding="28dp"
    tools:context=".ui.AppointmentsHubFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.03"
        android:text="@string/appointments_title"
        android:textColor="@color/bob_black"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/appointments_hint"
        android:textColor="@color/bob_muted"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_has_appointment"
        style="@style/BuddyButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="28dp"
        android:text="@string/appointments_has" />

    <Button
        android:id="@+id/btn_no_appointment"
        style="@style/BuddyButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:text="@string/appointments_none" />

    <Button
        android:id="@+id/btn_call_operator"
        style="@style/BuddyButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:text="@string/appointments_call_operator" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btn_back"
        style="@style/BuddyButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/back" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:orientation="horizontal"
    android:padding="@dimen/screen_padding"
    tools:context=".ui.VoiceMemosFragment">

    <!-- Sinistra: controlli registrazione -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BuddyTitle"
            android:text="@string/voice_memos_title" />

        <TextView
            android:id="@+id/text_memo_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/BuddySubtitle"
            android:text="@string/voice_memos_hint" />

        <TextView
            android:id="@+id/text_memo_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:text="@string/voice_memos_idle"
            android:textColor="@color/bob_black"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Tocca Inizia a registrare" />

        <TextView
            android:id="@+id/text_memo_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/bob_muted"
            android:textSize="18sp"
            android:visibility="gone"
            tools:text="00:12"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btn_memo_start"
            style="@style/BuddyButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_primary"
            android:layout_marginTop="20dp"
            android:text="@string/voice_memos_start" />

        <Button
            android:id="@+id/btn_memo_stop"
            style="@style/BuddyButton.Danger"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_primary"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="@string/voice_memos_stop" />

        <TextView
            android:id="@+id/text_memo_transcript"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_round"
            android:padding="14dp"
            android:textColor="@color/bob_muted"
            android:textSize="14sp"
            tools:text="Ultima trascrizione…" />

        <Button
            android:id="@+id/btn_memo_back"
            style="@style/BuddyButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_marginTop="10dp"
            android:text="@string/back" />
    </LinearLayout>

    <!-- Destra: ultimi memo -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BuddySectionLabel"
            android:text="@string/voice_memos_recent_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_memos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/text_memos_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/BuddySubtitle"
            android:text="@string/voice_memos_empty"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

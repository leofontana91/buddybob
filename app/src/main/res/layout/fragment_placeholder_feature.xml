<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:orientation="vertical"
    android:padding="28dp"
    tools:context=".ui.PlaceholderFeatureFragment">

    <TextView
        android:id="@+id/text_feature_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.03"
        android:textColor="@color/bob_black"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:text="Appuntamenti" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/feature_coming_soon"
        android:textColor="@color/bob_muted"
        android:textSize="16sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btn_feature_back"
        style="@style/BuddyButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/back" />
</LinearLayout>

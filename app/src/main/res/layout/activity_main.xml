<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <include layout="@layout/view_system_status" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/container_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout="@layout/fragment_home" />

        <!-- Un solo spazio: ascoltato / detto si sostituiscono -->
        <LinearLayout
            android:id="@+id/bar_voice_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_voice_bar"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/label_voice_heard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BuddySectionLabel"
                android:text="@string/voice_heard_label"
                android:textColor="@color/bob_teal" />

            <TextView
                android:id="@+id/text_voice_transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:letterSpacing="-0.02"
                android:maxLines="4"
                android:textColor="@color/bob_black"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Bob, accompagnami in reception" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/overlay_place_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E60D2C50"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/overlay_place_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="72dp"
                android:contentDescription="@string/places_title"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <VideoView
                android:id="@+id/overlay_place_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginBottom="72dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/overlay_place_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:padding="20dp"
                android:textColor="@color/bob_white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>

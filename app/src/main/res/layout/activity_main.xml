<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_black"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <include layout="@layout/view_system_status" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bob_cream">

        <FrameLayout
            android:id="@+id/container_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout="@layout/fragment_home" />

        <!-- Un solo spazio: ascoltato / detto si sostituiscono -->
        <LinearLayout
            android:id="@+id/bar_voice_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/bg_voice_bar"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/label_voice_heard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BuddySectionLabel"
                android:text="@string/voice_heard_label"
                android:textColor="@color/bob_teal" />

            <TextView
                android:id="@+id/text_voice_transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:letterSpacing="-0.02"
                android:maxLines="4"
                android:textColor="@color/bob_black"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Bob, accompagnami in reception" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/overlay_place_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bob_navy"
            android:clickable="true"
            android:elevation="24dp"
            android:focusable="true"
            android:visibility="gone">

            <com.buddybob.robot.ui.avatar.BobAvatarView
                android:id="@+id/overlay_place_bob"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="80dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/overlay_place_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="80dp"
                android:contentDescription="@string/places_title"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <VideoView
                android:id="@+id/overlay_place_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginBottom="80dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/overlay_place_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#CC0D2C50"
                android:gravity="center"
                android:padding="20dp"
                android:paddingBottom="72dp"
                android:textColor="@color/bob_white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Stop durante movimento: basso al centro -->
            <Button
                android:id="@+id/btn_stop_moving"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_button_danger"
                android:elevation="10dp"
                android:minWidth="120dp"
                android:paddingHorizontal="28dp"
                android:text="@string/voice_stop"
                android:textColor="@color/bob_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Stop durante parlato / elaborazione: in basso a destra (spazio dialogo) -->
        <Button
            android:id="@+id/btn_stop_speak"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="48dp"
            android:background="@drawable/bg_button_danger"
            android:elevation="16dp"
            android:minWidth="112dp"
            android:paddingHorizontal="24dp"
            android:text="@string/voice_stop"
            android:textColor="@color/bob_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

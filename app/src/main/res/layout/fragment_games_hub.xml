<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_ink"
    tools:context=".ui.games.GamesHubFragment">

    <android.webkit.WebView
        android:id="@+id/webview_games"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress_games"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_games_error"
        style="@style/BobBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="40dp"
        android:textColor="@color/bob_accent_ink"
        android:visibility="gone"
        tools:text="Non riesco ad aprire i giochi"
        tools:visibility="visible" />

    <Button
        android:id="@+id/btn_games_close"
        style="@style/BobGhost"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/row_height"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:elevation="12dp"
        android:minWidth="140dp"
        android:paddingHorizontal="24dp"
        android:text="@string/games_close"
        android:textColor="@color/bob_ink" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="20dp"
    tools:context=".ui.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:background="@drawable/bg_logo_chip"
            android:contentDescription="@string/app_name"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_bob_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:letterSpacing="-0.04"
            android:text="BOB"
            android:textAllCaps="true"
            android:textColor="@color/bob_black"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/status_waiting_robot"
        android:textColor="@color/bob_muted"
        android:textSize="@dimen/text_small"
        tools:text="Pronto" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/bob_line" />

    <Button
        android:id="@+id/btn_back_reception"
        style="@style/BuddyButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height_secondary"
        android:layout_marginTop="12dp"
        android:text="@string/back_to_reception"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_pairing"
        style="@style/BuddyButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height_secondary"
        android:layout_marginTop="8dp"
        android:text="@string/pairing_menu" />

    <Button
        android:id="@+id/btn_go_to"
        style="@style/BuddyButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height_primary"
        android:layout_marginTop="12dp"
        android:text="@string/go_to"
        android:textSize="@dimen/btn_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_motion"
            style="@style/BuddyButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_weight="1"
            android:text="@string/motion" />

        <Button
            android:id="@+id/btn_speech"
            style="@style/BuddyButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_weight="1"
            android:text="@string/speech" />

        <Button
            android:id="@+id/btn_follow"
            style="@style/BuddyButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_weight="1"
            android:text="@string/follow" />

        <Button
            android:id="@+id/btn_halt"
            style="@style/BuddyButton.Danger"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_weight="1"
            android:text="@string/halt" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.08"
        android:text="LOG"
        android:textAllCaps="true"
        android:textColor="@color/bob_navy"
        android:textSize="@dimen/text_label"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel_round"
        android:fontFamily="monospace"
        android:gravity="bottom"
        android:padding="12dp"
        android:textColor="@color/bob_muted"
        android:textSize="@dimen/text_label"
        tools:text="RobotApi connected" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Conversazione: Bob grande al centro, microfono e indietro -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.SpeechFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.buddybob.robot.ui.avatar.BobAvatarView
            android:id="@+id/bob_avatar_speech"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/text_speech_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/BuddyTitle"
            android:text="@string/speech_talk_title"
            android:textColor="@color/bob_black" />

        <TextView
            android:id="@+id/text_speech_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            style="@style/BuddySubtitle"
            android:text="@string/speech_talk_hint" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_speech_back"
        style="@style/BuddyButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/btn_height_secondary"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:minWidth="120dp"
        android:text="@string/back" />

    <ImageButton
        android:id="@+id/btn_voice_mic"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/bg_mic_idle"
        android:contentDescription="@string/voice_mic_button"
        android:elevation="6dp"
        android:padding="18dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic_white" />
</FrameLayout>

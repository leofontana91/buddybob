<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".ui.SpeechFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/speech"
        android:textColor="@color/bob_black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_tts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/bob_panel"
        android:hint="@string/default_tts"
        android:padding="14dp"
        android:textColor="@color/bob_black"
        android:textColorHint="@color/bob_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn_speak" style="@style/BuddyButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Parla" />
        <Button android:id="@+id/btn_stop_tts" style="@style/BuddyButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="Stop TTS" />
        <Button android:id="@+id/btn_asr_on" style="@style/BuddyButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="ASR ON" />
        <Button android:id="@+id/btn_asr_off" style="@style/BuddyButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="ASR OFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_feedback"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@color/bob_panel"
        android:padding="12dp"
        android:textColor="@color/bob_muted"
        tools:text="TTS complete" />

    <Button
        android:id="@+id/btn_back"
        style="@style/BuddyButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/back" />
</LinearLayout>

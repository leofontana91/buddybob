<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.ReceptionFragment">

    <FrameLayout
        android:id="@+id/panel_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <com.buddybob.robot.ui.avatar.BobAvatarView
                android:id="@+id/bob_avatar_idle"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                style="@style/BuddyTitle"
                android:text="@string/reception_idle_title"
                android:textColor="@color/bob_black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                style="@style/BuddySubtitle"
                android:text="@string/reception_idle_hint" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panel_greeting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone"
        tools:visibility="gone">

        <com.buddybob.robot.ui.avatar.BobAvatarView
            android:id="@+id/bob_avatar_greeting"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/text_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:letterSpacing="-0.03"
            android:text="@string/reception_welcome"
            android:textColor="@color/bob_black"
            android:textSize="@dimen/greeting_text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bob_white"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <com.buddybob.robot.ui.avatar.BobAvatarView
                android:id="@+id/bob_avatar_menu"
                android:layout_width="@dimen/avatar_size_compact"
                android:layout_height="@dimen/avatar_size_compact"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_menu_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/BuddyTitle"
                    android:text="@string/reception_menu_title"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    style="@style/BuddySubtitle"
                    android:text="@string/reception_menu_hint"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bob_line" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_menu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="18dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="20dp" />
    </LinearLayout>

    <!-- Impostazioni: in alto a sinistra -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/robot_settings_gear"
        android:elevation="4dp"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_settings_gear" />

    <!-- Microfono: in alto a destra -->
    <ImageButton
        android:id="@+id/btn_voice_mic"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_mic_idle"
        android:contentDescription="@string/voice_mic_button"
        android:elevation="6dp"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic_white" />
</FrameLayout>

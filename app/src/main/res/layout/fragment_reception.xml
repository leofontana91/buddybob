<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    tools:context=".ui.ReceptionFragment">

    <!-- Idle: waiting for a guest -->
    <LinearLayout
        android:id="@+id/panel_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <ImageView
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_bob_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="-0.03"
            android:text="@string/reception_idle_title"
            android:textColor="@color/bob_black"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/reception_idle_hint"
            android:textColor="@color/bob_muted"
            android:textSize="@dimen/text_body" />

        <Button
            android:id="@+id/btn_simulate_guest"
            style="@style/BuddyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minWidth="200dp"
            android:text="@string/reception_simulate" />
    </LinearLayout>

    <!-- Greeting: smiling face -->
    <LinearLayout
        android:id="@+id/panel_greeting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/image_face"
            android:layout_width="@dimen/face_size"
            android:layout_height="@dimen/face_size"
            android:contentDescription="@string/reception_face"
            android:src="@drawable/face_smile" />

        <TextView
            android:id="@+id/text_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="-0.03"
            android:text="@string/reception_welcome"
            android:textColor="@color/bob_black"
            android:textSize="@dimen/greeting_text"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Menu after greeting -->
    <LinearLayout
        android:id="@+id/panel_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.03"
            android:text="@string/reception_menu_title"
            android:textColor="@color/bob_black"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/reception_menu_hint"
            android:textColor="@color/bob_muted"
            android:textSize="@dimen/text_body" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_menu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reception_reset"
                style="@style/BuddyButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_secondary"
                android:layout_weight="1"
                android:text="@string/reception_reset" />

            <Button
                android:id="@+id/btn_reception_pair"
                style="@style/BuddyButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_secondary"
                android:layout_weight="1"
                android:text="@string/pairing_menu" />

            <Button
                android:id="@+id/btn_reception_tech"
                style="@style/BuddyButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_secondary"
                android:layout_weight="1"
                android:text="@string/reception_tech" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

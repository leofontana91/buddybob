<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bob_cream"
    tools:context=".ui.ReceptionFragment">

    <!-- Idle: logo + attesa; gear in angolo -->
    <FrameLayout
        android:id="@+id/panel_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageView
                android:layout_width="@dimen/logo_size"
                android:layout_height="@dimen/logo_size"
                android:background="@drawable/bg_logo_chip"
                android:contentDescription="@string/app_name"
                android:padding="6dp"
                android:src="@drawable/logo_bob_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="-0.03"
                android:text="@string/reception_idle_title"
                android:textColor="@color/bob_navy"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/reception_idle_hint"
                android:textColor="@color/bob_navy"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_idle_settings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/robot_settings_gear"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_gear" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panel_greeting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/image_face"
            android:layout_width="@dimen/face_size"
            android:layout_height="@dimen/face_size"
            android:contentDescription="@string/reception_face"
            android:src="@drawable/face_smile" />

        <TextView
            android:id="@+id/text_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="-0.03"
            android:text="@string/reception_welcome"
            android:textColor="@color/bob_navy"
            android:textSize="@dimen/greeting_text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bob_navy"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_menu_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.03"
                    android:text="@string/reception_menu_title"
                    android:textColor="@color/bob_white"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/reception_menu_hint"
                    android:textColor="@color/bob_white"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_menu_settings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/robot_settings_gear"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings_gear_white" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_menu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="16dp" />
    </LinearLayout>
</FrameLayout>

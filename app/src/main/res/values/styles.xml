<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/bob_navy</item>
        <item name="colorPrimaryDark">@color/bob_black</item>
        <item name="colorAccent">@color/bob_teal</item>
        <item name="android:windowBackground">@color/bob_cream</item>
        <item name="android:textColorPrimary">@color/bob_black</item>
        <item name="android:textColor">@color/bob_black</item>
        <!-- Su OrionStar le icone di sistema (batteria, ora…) restano chiare:
             la status bar deve essere scura, altrimenti spariscono sul beige. -->
        <item name="android:statusBarColor">@color/bob_black</item>
        <item name="android:navigationBarColor">@color/bob_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Secondary: soft surface + hairline -->
    <style name="BuddyButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_margin">4dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bob_black</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Primary CTA -->
    <style name="BuddyButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/bob_white</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="BuddyButton.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/bob_white</item>
    </style>

    <style name="BuddyTitle">
        <item name="android:textColor">@color/bob_black</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BuddySubtitle">
        <item name="android:textColor">@color/bob_muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="BuddySectionLabel">
        <item name="android:textColor">@color/bob_muted</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>

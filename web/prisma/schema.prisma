// Prisma schema — BOB multi-tenant: Super Admin → Admin → Users + Robots
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL for the app (Supabase transaction pooler :6543)
  url       = env("DATABASE_URL")
  // Direct DB for migrate / db push (Supabase :5432) — pooler hangs Prisma DDL
  directUrl = env("DIRECT_URL")
}

/// SUPER_ADMIN | ADMIN | USER
model Account {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Persona di riferimento (admin) o nome utente
  name         String
  /// Null finché l'admin non completa l'attivazione via email
  passwordHash String?
  role         String
  /// pending | active | disabled
  status       String  @default("active")
  activationToken   String?   @unique
  activationExpires DateTime?

  /// Solo ADMIN (azienda) — compilati dal Super Admin
  companyName String?
  address     String?
  city        String?

  /// Moduli abilitati dal Super Admin (JSON). Solo ADMIN.
  modulesJson String @default("{}")

  /// For USER accounts: owning ADMIN
  adminId String?
  admin   Account?  @relation("AdminUsers", fields: [adminId], references: [id], onDelete: Cascade)
  users   Account[] @relation("AdminUsers")

  robotLinks   AdminRobot[]
  appointments Appointment[] @relation("AppointmentGuestUser")
  hostedAppts  Appointment[] @relation("AppointmentHost")
  createdAt    DateTime      @default(now())
}

model Robot {
  id             String @id
  displayName    String
  /// Numero di serie fisico del robot (univoco)
  serialNumber   String @unique
  apiKey         String @unique
  /// Abilitato dal Super Admin
  enabled        Boolean @default(true)
  /// Codice a 6 cifre, valido fino a pairingOpenUntil
  pairingCode       String?
  pairingOpenUntil  DateTime?
  timezone       String  @default("Europe/Rome")
  locale         String  @default("it-IT")
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime?
  lastPlace      String?
  lastActivity   String?
  settings       RobotSettings?
  appointments   Appointment[]
  operatorAlerts OperatorAlert[]
  adminLinks     AdminRobot[]
  mapPlaces      MapPlace[]
  placeGroups    PlaceContentGroup[]
  commands       RobotCommand[]
  formTemplates    FormTemplate[]
  accessVisits     AccessVisit[]
  androidReleases  RobotAndroidRelease[]
  savedPhrases     SavedPhrase[]
  tasks            RobotTask[]
  voiceMemos       VoiceMemo[]
}

model AdminRobot {
  adminId String
  robotId String
  admin   Account @relation(fields: [adminId], references: [id], onDelete: Cascade)
  robot   Robot   @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@id([adminId, robotId])
}

model RobotSettings {
  id                String @id @default(cuid())
  robotId           String @unique
  robot             Robot  @relation(fields: [robotId], references: [id], onDelete: Cascade)
  bookingMode       String @default("qr")
  bookingUrl        String @default("")
  checkInSpeak      String @default("Perfetto, ho avvisato che sei arrivato")
  callOperatorSpeak String @default("Sto chiamando un operatore")
  /// Canali notifica «Chiama operatore»
  callOperatorNotifyInbox Boolean @default(true)
  callOperatorNotifyPopup Boolean @default(false)
  callOperatorNotifyEmail Boolean @default(false)
  /// Destinatario email (obbligatorio se notifyEmail)
  callOperatorEmail     String  @default("")
  dayStart          String @default("09:00")
  dayEnd            String @default("18:00")
  slotMinutes       Int    @default(30)
  /// Giorni prenotabili ISO 1=lun … 7=dom (default lun–ven)
  bookableWeekdays  String @default("1,2,3,4,5")
  /// PIN to unlock robot on-device settings
  settingsPin       String @default("1234")
  /// shared | per_place | groups — come si configurano frasi e media dei punti mappa
  placeContentMode  String @default("per_place")
  /// JSON PlaceContent usato se placeContentMode = shared
  placeSharedJson   String @default("{}")
  /// Istruzioni custom per l'AI vocale (sinonimi, cosa può/non può rispondere)
  voiceInstructions String @default("")
  /// Lingua parlato/risposte: it | en | de | fr | es (UI resta italiana)
  speechLanguage    String @default("it")

  /// Accoglienza: frase al rilevamento ospite
  welcomeSpeak       String @default("Benvenuto")
  howCanIHelpSpeak   String @default("Come posso aiutarti?")
  /// Secondi di inattività fuori reception prima di tornare al menu/standby
  receptionCooldownSec Int  @default(45)
  /// Sensibilità rilevazione 1 (solo vicino) … 5 (anche lontano)
  receptionDetectLevel Int  @default(2)
  /// Punto mappa di accoglienza / ritorno
  standbyPlace       String @default("")
  /// Testo a schermo in idle (accoglienza senza ospite)
  idleDisplayText    String @default("")
  idleMediaUrl       String @default("")
  idleMediaContentType String @default("")
  /// Ogni quanti secondi ripresentare / ciclare i media in idle (0 = sempre)
  idleMediaIntervalSec Int  @default(20)
  /// person = si interrompe se vede qualcuno; tap = solo al tocco monitor
  idleMediaStopMode  String @default("person")

  /// Rubrica ospiti attiva su questo robot / console
  rubricaEnabled       Boolean @default(true)
  rubricaCollectPhone  Boolean @default(true)
  rubricaCollectEmail  Boolean @default(true)
  rubricaCollectCompany Boolean @default(false)
  rubricaCollectNotes  Boolean @default(true)

  /// Sync calendari esterni: none | ical | google | teams
  calendarSyncProvider String @default("none")
  calendarSyncEnabled  Boolean @default(false)
  /// URL feed iCal (Google «indirizzo segreto», Outlook ICS, ecc.)
  calendarSyncIcalUrl  String @default("")
  calendarLastSyncAt   DateTime?
}

/// Contatto ospite in rubrica (per azienda)
model GuestContact {
  id        String   @id @default(cuid())
  adminId   String
  name      String
  phone     String   @default("")
  email     String   @default("")
  company   String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime?

  @@index([adminId, name])
  @@index([adminId, phone])
  @@index([adminId, email])
}

model Appointment {
  id         String   @id @default(cuid())
  robotId    String
  robot      Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  /// Legacy: a volte ospite piattaforma; preferire hostUserId per il referente
  userId     String?
  user       Account? @relation("AppointmentGuestUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Utente azienda con cui si ha l'appuntamento (lane calendario)
  hostUserId String?
  host       Account? @relation("AppointmentHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  typeId     String?
  type       AppointmentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  roomId     String?
  room       MeetingRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  guestName  String
  guestPhone String?
  startsAt   DateTime
  /// Fine intervallo (riserva sala / durata tipo)
  endsAt     DateTime?
  /// scheduled | checked_in | in_progress | completed | cancelled | no_show
  status     String   @default("scheduled")
  notes      String?
  /// Id evento esterno (Google / Teams / iCal) per sync senza duplicati
  externalId     String?
  externalSource String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  alerts     OperatorAlert[]

  @@index([robotId, externalSource, externalId])
  @@index([robotId, startsAt])
  @@index([userId, startsAt])
  @@index([hostUserId, startsAt])
  @@index([roomId, startsAt])
  @@index([typeId])
}

/// Tipologia visita (durata) — per azienda
model AppointmentType {
  id               String   @id @default(cuid())
  adminId          String
  name             String
  durationMinutes  Int      @default(30)
  /// Colore UI calendario (hex opzionale)
  color            String   @default("#1a1a1a")
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  rooms            AppointmentTypeRoom[]
  appointments     Appointment[]

  @@index([adminId, active])
}

/// Sala prenotabile — per azienda; opzionale collegamento a punto mappa robot
model MeetingRoom {
  id            String   @id @default(cuid())
  adminId       String
  name          String
  /// Nome MapPlace sul robot per accompagnare l'ospite (se presente)
  mapPlaceName  String?
  /// Orari propri (null = usa orari globali del robot)
  dayStart      String?
  dayEnd        String?
  /// Giorni prenotabili ISO 1=lun … 7=dom, es. "1,2,3,4,5". Null = globali
  weekdays      String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  types         AppointmentTypeRoom[]
  appointments  Appointment[]

  @@index([adminId, active])
}

model AppointmentTypeRoom {
  typeId String
  roomId String
  type   AppointmentType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  room   MeetingRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([typeId, roomId])
}

model OperatorAlert {
  id            String       @id @default(cuid())
  robotId       String
  robot         Robot        @relation(fields: [robotId], references: [id], onDelete: Cascade)
  type          String
  message       String
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  /// Mostra in Inbox
  inInbox       Boolean      @default(true)
  /// Mostra popup immediato nella console admin
  asPopup       Boolean      @default(false)
  readAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([robotId, createdAt])
}

/// Gruppo di punti mappa che condividono le stesse frasi/media
model PlaceContentGroup {
  id          String     @id @default(cuid())
  robotId     String
  robot       Robot      @relation(fields: [robotId], references: [id], onDelete: Cascade)
  name        String
  /// JSON PlaceContent
  contentJson String     @default("{}")
  sortOrder   Int        @default(0)
  places      MapPlace[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([robotId])
}

/// Punti mappa sincronizzati dal robot (Vai a…)
model MapPlace {
  id        String   @id @default(cuid())
  robotId   String
  robot     Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  name      String
  x         Float    @default(0)
  y         Float    @default(0)
  theta     Float    @default(0)
  /// Etichetta visibile al posto del nome tecnico
  label           String?
  /// Cosa dice il robot quando parte verso questo punto
  speakOnDepart   String?
  /// Cosa dice mentre si muove
  speakWhileMoving String?
  /// Cosa dice quando arriva
  speakOnArrive   String?
  /// Cosa mostra sul monitor quando parte (testo o JSON { text, media })
  displayOnDepart String?
  /// Cosa mostra sul monitor mentre si muove
  displayWhileMoving String?
  /// Cosa mostra sul monitor quando arriva
  displayOnArrive String?
  /// Secondi di attesa al punto prima di proseguire (0 = non aspettare)
  waitSeconds     Int     @default(0)
  groupId         String?
  group           PlaceContentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt

  @@unique([robotId, name])
  @@index([groupId])
}

/// Coda comandi dal web verso il robot (goto / speak / stop / task)
model RobotCommand {
  id        String    @id @default(cuid())
  robotId   String
  robot     Robot     @relation(fields: [robotId], references: [id], onDelete: Cascade)
  /// goto | speak | stop | task
  type      String
  payload   String    @default("{}")
  /// pending | running | done | failed
  status    String    @default("pending")
  error     String?
  createdAt DateTime  @default(now())
  ackedAt   DateTime?

  @@index([robotId, status, createdAt])
}

model SavedPhrase {
  id        String   @id @default(cuid())
  robotId   String
  robot     Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([robotId, sortOrder])
}

model RobotTask {
  id        String   @id @default(cuid())
  robotId   String
  robot     Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  name      String
  /// JSON array of steps: speak | button | goto | return | wait
  steps     String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([robotId])
}

model FormTemplate {
  id          String           @id @default(cuid())
  robotId     String
  robot       Robot            @relation(fields: [robotId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean          @default(true)
  /// Email dove inviare ogni compilazione (opzionale)
  notifyEmail String           @default("")
  createdAt   DateTime         @default(now())
  fields      FormField[]
  submissions FormSubmission[]
}

model FormField {
  id         String       @id @default(cuid())
  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  /// text | textarea | yesno | number
  type       String       @default("text")
  required   Boolean      @default(true)
  sortOrder  Int          @default(0)
}

model FormSubmission {
  id          String       @id @default(cuid())
  templateId  String
  template    FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  robotId     String
  answersJson String
  guestName   String?
  createdAt   DateTime     @default(now())

  @@index([robotId, createdAt])
  @@index([templateId, createdAt])
}

model AccessVisit {
  id         String    @id @default(cuid())
  robotId    String
  robot      Robot     @relation(fields: [robotId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  /// Utente azienda con cui ha appuntamento / da incontrare (opzionale)
  hostUserId String?
  hostName   String    @default("")
  enteredAt  DateTime  @default(now())
  exitedAt   DateTime?

  @@index([robotId, enteredAt])
  @@index([robotId, exitedAt])
}

/// Memo vocali registrati dal robot (audio + trascrizione).
model VoiceMemo {
  id           String   @id @default(cuid())
  robotId      String
  robot        Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  /// URL pubblico audio (Supabase Storage)
  audioUrl     String
  storagePath  String
  contentType  String   @default("audio/mp4")
  durationMs   Int?
  /// Trascrizione Whisper / testo
  transcript   String   @default("")
  /// pending | ready | failed
  status       String   @default("pending")
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([robotId, createdAt])
}

/// Android OTA-like releases uploaded by SUPER_ADMIN (robot-specific).
model RobotAndroidRelease {
  id          String   @id @default(cuid())
  robotId     String
  robot       Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  versionName String
  /// versionCode as integer (optional, depends on what the SUPER_ADMIN provides).
  versionCode Int?

  /// Path inside Supabase Storage (NOT a public URL).
  storagePath String
  sha256      String?

  notes     String?
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  @@unique([robotId, versionName])
  @@index([robotId, isActive])
}

/// Android OTA-like releases uploaded by SUPER_ADMIN (global, for all robots).
model GlobalAndroidRelease {
  id          String   @id @default(cuid())
  versionName String
  versionCode Int?

  storagePath String
  sha256      String?

  notes     String?
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  @@unique([versionName])
  @@index([isActive])
}
